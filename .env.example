# 네이버 지도 API Client ID (ncp) - https://console.ncloud.com
VITE_NAVER_CLIENT_ID=your_naver_client_id

# 서울 열린데이터광장 공원음수대 API 인증키 - https://data.seoul.go.kr
VITE_SEOUL_API_KEY=your_seoul_api_key

# 서울시 공원음수대 서비스명 (데이터 생성 스크립트용)
VITE_SEOUL_WATER_SERVICE=TbViewGisArisu

# 기본 반경(m) - '내 주변' 검색 초기값
VITE_DEFAULT_RADIUS=1000

# 선택한 음수대를 잇는 무료 보행 경로 API (Valhalla 호환). 비우면 기본 공개 서버를 사용합니다.
VITE_ROUTING_API_URL=https://valhalla1.openstreetmap.de/route

# 원격 최신 데이터 URL (앱 재배포 없이 데이터 갱신). 비우면 로컬 번들만 사용.
VITE_DATA_URL=

# Android 앱의 OTA 업데이트. 문제 발생 시 false로 긴급 비활성화할 수 있습니다.
VITE_LIVE_UPDATE_ENABLED=true
VITE_LIVE_UPDATE_MANIFEST_URL=https://share-water-ota.pages.dev/live-update/manifest.json

# Google AdMob (기본값은 모두의 음수대 운영 배너)
# 로컬/테스트 빌드에서 강제로 테스트 광고를 표시하려면 VITE_ADMOB_TEST=true를 사용합니다.
# 광고를 긴급 비활성화하려면 LIVE를 false로 변경합니다.
VITE_ADMOB_LIVE=true
VITE_ADMOB_TEST=false
VITE_ADMOB_BANNER_ID=ca-app-pub-9017259597860535/9371049904
