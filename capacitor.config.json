{
  "appId": "com.sharewater.app",
  "appName": "모두의 음수대",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true
    },
    "Geolocation": {
      "permissions": [
        "location"
      ]
    }
  },
  "ios": {
    "includePlugins": [
      "@capacitor/app-launcher",
      "@capacitor/filesystem",
      "@capacitor/geolocation",
      "@capacitor/share"
    ],
    "scrollEnabled": false
  }
}
