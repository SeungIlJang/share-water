{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "share-water-community-api",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "share-water-community",
    "database_id": "270b5e01-5fcb-40b8-9382-cb9a46156c16"
  }],
  "ratelimits": [{
    "name": "WRITE_LIMITER",
    "namespace_id": "20261022",
    "simple": { "limit": 10, "period": 60 }
  }]
}
